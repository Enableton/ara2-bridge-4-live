+// BRIDGEHOST: create the edit controller half of the effect and connect it to the component (idempotent).
+// Done at creation time because some ARA plug-ins (VocAlign) expect it to exist when binding to the document.
+static int32_t bridgeEnsureController (VST3Effect vst3Effect)
+{
+    if (vst3Effect->controller)
+        return 0;
+
+    IPtr<IEditController> controller;
+    if ((vst3Effect->component->queryInterface (IEditController::iid, (void**) &controller) != kResultOk) || !controller)
+    {
+        TUID controllerClassID;
+        if (vst3Effect->component->getControllerClassId (controllerClassID) != kResultOk)
+            return 1;
+        if ((vst3Effect->binary->pluginFactory->createInstance (controllerClassID, IEditController::iid, (void**) &controller) != kResultOk) || !controller)
+            return 2;
+        if (controller->initialize (bridgeHostContext ()) != kResultOk)
+            return 3;
+        vst3Effect->controllerIsSeparate = true;
+
+        FUnknownPtr<IConnectionPoint> componentPoint { vst3Effect->component };
+        FUnknownPtr<IConnectionPoint> controllerPoint { controller };
+        if (componentPoint && controllerPoint)
+        {
+            componentPoint->connect (controllerPoint);
+            controllerPoint->connect (componentPoint);
+        }
+    }
+    controller->setComponentHandler (&gBridgeComponentHandler);
+    vst3Effect->controller = controller;
+    return 0;
+}
+
+// BRIDGEHOST: create the edit controller (if needed) and attach its editor view to the given NSView.
+// returns 0 on success, nonzero error code otherwise.
+int32_t VST3AttachEditor (VST3Effect vst3Effect, void* nsView, int32_t* width, int32_t* height)
+{
+    if (const int32_t error { bridgeEnsureController (vst3Effect) })
+        return error;
+
+    IPtr<IPlugView> view { vst3Effect->controller->createView (ViewType::kEditor), false };
+    if (!view)
+        return 4;
+    if (view->isPlatformTypeSupported (kPlatformTypeNSView) != kResultTrue)
+        return 5;
+    ViewRect rect {};
+    view->getSize (&rect);
+    if (width)
+        *width = rect.right - rect.left;
+    if (height)
+        *height = rect.bottom - rect.top;
+    if (view->attached (nsView, kPlatformTypeNSView) != kResultOk)
+        return 6;
+    vst3Effect->view = view;
+    return 0;
+}
+
+// BRIDGEHOST: tell the editor view its new size (in points)
+void VST3ResizeEditor (VST3Effect vst3Effect, int32_t width, int32_t height)
+{
+    if (vst3Effect->view)
+    {
+        ViewRect rect (0, 0, width, height);
+        vst3Effect->view->onSize (&rect);
+    }
+}
+
 void VST3DestroyEffect (VST3Effect vst3Effect)
 {
+    if (vst3Effect->view)       // BRIDGEHOST
+    {
+        vst3Effect->view->removed ();
+        vst3Effect->view = nullptr;
+    }
+    if (vst3Effect->controller)
+    {
+        // BRIDGEHOST: undo what bridgeEnsureController set up, in reverse order, before terminating
+        vst3Effect->controller->setComponentHandler (nullptr);
+        if (vst3Effect->controllerIsSeparate)
+        {
+            FUnknownPtr<IConnectionPoint> componentPoint { vst3Effect->component };
+            FUnknownPtr<IConnectionPoint> controllerPoint { vst3Effect->controller };
+            if (componentPoint && controllerPoint)
+            {
+                componentPoint->disconnect (controllerPoint);
+                controllerPoint->disconnect (componentPoint);
+            }
+            vst3Effect->controller->terminate ();
+        }
+        vst3Effect->controller = nullptr;
+    }
     tresult ARA_MAYBE_UNUSED_VAR (result);
     result = vst3Effect->component->terminate ();
     ARA_INTERNAL_ASSERT (result == kResultOk);
